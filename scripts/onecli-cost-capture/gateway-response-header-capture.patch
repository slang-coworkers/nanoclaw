+/// Lowercased response-header names to capture into `request_logs.extra_data`,
+/// read once from `ONECLI_CAPTURE_RESPONSE_HEADERS` (comma-separated). Empty =
+/// disabled (default), so this is a no-op unless explicitly configured. Generic
+/// on purpose — the gateway stays provider-agnostic; set it to
+/// `x-litellm-response-cost-original,x-litellm-model-id` to record per-request
+/// cost beside the already-logged `agent_id`.
+fn capture_header_allowlist() -> &'static [String] {
+    static ALLOW: std::sync::OnceLock<Vec<String>> = std::sync::OnceLock::new();
+    ALLOW.get_or_init(|| {
+        std::env::var("ONECLI_CAPTURE_RESPONSE_HEADERS")
+            .unwrap_or_default()
+            .split(',')
+            .map(|s| s.trim().to_ascii_lowercase())
+            .filter(|s| !s.is_empty())
+            .collect()
+    })
+}
+
+/// Serialize the allowlisted response headers as a JSON object string (for the
+/// `request_logs.extra_data` jsonb column), or "" when none are configured or
+/// present.
+fn capture_headers(resp_headers: &hyper::HeaderMap) -> String {
+    let allow = capture_header_allowlist();
+    if allow.is_empty() {
+        return String::new();
+    }
+    let mut map = serde_json::Map::new();
+    for name in allow {
+        if let Some(val) = resp_headers.get(name.as_str()).and_then(|v| v.to_str().ok()) {
+            map.insert(name.clone(), serde_json::Value::String(val.to_string()));
+        }
+    }
+    if map.is_empty() {
+        String::new()
+    } else {
+        serde_json::to_string(&serde_json::Value::Object(map)).unwrap_or_default()
+    }
+}
+
