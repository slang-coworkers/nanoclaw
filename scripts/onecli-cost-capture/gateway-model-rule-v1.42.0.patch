+/// Whether the top-level object of `body` holds the key `name` more than once, spelled with any
+/// ASCII case, or is not an object at all. A JSON parser may keep the first, the last or a
+/// case-folded copy of such a key, so another parser in the path could read a different value than
+/// we do. We treat that body as unreadable instead of choosing one.
+fn top_level_key_is_ambiguous(body: &[u8], name: &str) -> bool {
+    use serde::de::{Deserializer, IgnoredAny, MapAccess, Visitor};
+    struct Counter<'a>(&'a str);
+    impl<'de> Visitor<'de> for Counter<'_> {
+        type Value = bool;
+        fn expecting(&self, f: &mut std::fmt::Formatter) -> std::fmt::Result {
+            f.write_str("a JSON object")
+        }
+        fn visit_map<A: MapAccess<'de>>(self, mut map: A) -> Result<bool, A::Error> {
+            let mut seen = 0usize;
+            while let Some(key) = map.next_key::<String>()? {
+                if key.eq_ignore_ascii_case(self.0) {
+                    seen += 1;
+                }
+                map.next_value::<IgnoredAny>()?;
+            }
+            Ok(seen > 1)
+        }
+    }
+    let mut de = serde_json::Deserializer::from_slice(body);
+    de.deserialize_map(Counter(name)).unwrap_or(true)
+}
+
+/// The string at dotted path `key` of the JSON body, or `None` when the body is missing, is not
+/// JSON, repeats the first segment of `key` in its top-level object, or holds no string there.
+fn body_field(body: Option<&[u8]>, key: &str) -> Option<String> {
+    let body = body?;
+    if top_level_key_is_ambiguous(body, key.split('.').next().unwrap_or(key)) {
+        return None;
+    }
+    let mut node: serde_json::Value = serde_json::from_slice(body).ok()?;
+    for part in key.split('.') {
+        node = node.get_mut(part)?.take();
+    }
+    match node {
+        serde_json::Value::String(s) => Some(s),
+        _ => None,
+    }
+}
+
+/// Glob match where `*` matches any run of characters, including `/` and none.
+fn glob_match(pattern: &str, text: &str) -> bool {
+    let (p, t) = (pattern.as_bytes(), text.as_bytes());
+    let (mut pi, mut ti) = (0, 0);
+    let (mut star, mut mark) = (None, 0);
+    while ti < t.len() {
+        if pi < p.len() && p[pi] == b'*' {
+            star = Some(pi);
+            mark = ti;
+            pi += 1;
+        } else if pi < p.len() && p[pi] == t[ti] {
+            pi += 1;
+            ti += 1;
+        } else if let Some(s) = star {
+            pi = s + 1;
+            mark += 1;
+            ti = mark;
+        } else {
+            return false;
+        }
+    }
+    p[pi..].iter().all(|&c| c == b'*')
+}
