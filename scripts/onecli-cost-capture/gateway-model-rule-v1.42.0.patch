+        assert!(!at("/x?model=nvidia%2Fzai-org%2Fglm-5.3"));
+        assert!(at("/x?model=aws%2Fanthropic%2Fclaude"));
+        assert!(at("/x?model=aws%252Fanthropic%252Fclaude"));
+        // A model that is only open after a second decoding is not trusted.
+        assert!(at("/x?model=nvidia%252Fa"));
+        // Another parameter is not the model, and a fragment is not part of the query.
+        assert!(!at("/x?other=aws/anthropic/claude&model=nvidia/a"));
+        assert!(!at("/x?model=nvidia/a#model=aws/anthropic/claude"));
+        // An empty value is a value, and it is not open.
+        assert!(at("/x?model="));
+        assert!(at("/x?model"));
+    }
+
+    #[test]
+    fn query_in_holds_only_when_every_copy_is_listed() {
+        let r = query_rule("in");
+        assert!(matches_at(&r, None, "/x?model=nvidia/a"));
+        assert!(!matches_at(&r, None, "/x?model=nvidia/a&model=aws/b"));
+        assert!(!matches_at(&r, None, "/x"));
+    }
+
+    #[test]
+    fn a_query_condition_does_not_ask_for_the_body() {
+        let r = query_rule("not_in");
+        assert!(!needs_body_buffer(&[r]));
+    }
+
+    #[test]
+    fn canonical_path_is_one_spelling_of_each_route() {
+        for raw in [
+            "/model/info",
+            "/%6Dodel/info",
+            "/%6dodel/info",
+            "/model%2Finfo",
+            "/model%2finfo",
+            "//model/info",
+            "///model//info",
+            "/./model/info",
+            "/model/./info",
+            "/v1/../model/info",
+            "/a/b/../../model/info",
+            "/%256Dodel/info",
+            "/%25256Dodel/info",
+            "/%2e/model/info",
+            "/v1/%2e%2e/model/info",
+        ] {
+            assert_eq!(canonical_path(raw), "/model/info", "{raw}");
+        }
+        // The query string stays as it is, a trailing slash stays, and `..` cannot leave the root.
+        assert_eq!(canonical_path("/%6Dodel/info?model=a%2Fb"), "/model/info?model=a%2Fb");
+        assert_eq!(canonical_path("/model/"), "/model/");
+        assert_eq!(canonical_path("/../../model"), "/model");
+        assert_eq!(canonical_path(""), "/");
+        assert_eq!(canonical_path("/"), "/");
+        // A malformed escape stays, and a different route stays different.
+        assert_eq!(canonical_path("/a%zzb"), "/a%zzb");
+        assert_eq!(canonical_path("/models/info"), "/models/info");
+        assert_eq!(canonical_path("/Model/info"), "/Model/info");
+    }
+
+    #[test]
+    fn path_views_cover_one_decoding_and_a_full_decoding() {
+        let views = path_views("/model/%252e%252e/invoke");
+        assert!(views.contains(&"/model/%2e%2e/invoke".to_string()), "{views:?}");
+        assert!(views.contains(&"/invoke".to_string()), "{views:?}");
+        // A plain path has one view, and the query string rides along on each view.
+        assert_eq!(path_views("/model/info"), vec!["/model/info".to_string()]);
+        assert_eq!(
+            path_views("/%6Dodel/info?model=a"),
+            vec!["/%6Dodel/info?model=a".to_string(), "/model/info?model=a".to_string()]
+        );
+    }
+
+    #[test]
+    fn a_route_rule_holds_for_every_spelling_of_the_route() {
+        let block = PolicyRule {
+            name: "routes".into(),
+            path_pattern: "/model/*".into(),
+            method: None,
+            action: PolicyAction::Block,
+            conditions_raw: None,
+        };
+        let hits = |p: &str| crate::policy::matches_request(&block, "GET", p, None);
+        for p in [
+            "/model/info",
+            "/%6Dodel/info",
+            "/model%2Finfo",
+            "//model/info",
+            "/./model/info",
+            "/v1/../model/info",
+            "/model/info?x=1",
+            "/%256Dodel/new",
+            // A server that decodes once routes these to /model/<id>/invoke with an odd id, and a full
+            // decoding would resolve the `..` and lose the route.
+            "/model/%252e%252e/invoke",
+            "/model/%2e%2e/invoke",
+            "/%2e%2e/model/info",
+            "/model/%252e%252e%252finvoke",
+        ] {
+            assert!(hits(p), "{p}");
+        }
+        for p in ["/models/info", "/v1/model/info", "/v1/messages", "/Model/info"] {
+            assert!(!hits(p), "{p}");
+        }
+    }
+
+    #[test]
+    fn only_methods_with_a_body_are_buffered() {
+        assert!(method_has_body("post"));
+        assert!(method_has_body("PUT"));
+        assert!(!method_has_body("GET"));
+        assert!(!method_has_body("CONNECT"));
+    }
 }
