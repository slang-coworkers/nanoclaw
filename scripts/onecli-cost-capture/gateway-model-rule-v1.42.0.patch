+        let r = rule(PolicyAction::Block, Some(cond));
+        assert!(!matches(&r, Some(br#"{"model":"a"}"#)));
+    }
+
+    #[test]
+    fn rule_without_conditions_holds() {
+        assert!(matches(&rule(PolicyAction::Block, None), None));
+        assert!(matches(&rule(PolicyAction::Block, Some(json!([]))), None));
+        assert!(matches(&rule(PolicyAction::Block, Some(json!(null))), None));
+    }
+
+    #[test]
+    fn unknown_condition_holds_for_every_action() {
+        let unknown = json!([{"target": "header", "key": "x", "operator": "in", "value": ["y"]}]);
+        let bad_op = json!([{"target": "body", "key": "model", "operator": "regex", "value": ["x"]}]);
+        let no_key = json!([{"target": "body", "operator": "contains", "value": "x"}]);
+        let bad_value = json!([{"target": "body", "key": "model", "operator": "in", "value": 5}]);
+        for cond in [unknown, bad_op, no_key, bad_value] {
+            for action in [PolicyAction::Block, PolicyAction::Allow] {
+                assert!(matches(&rule(action, Some(cond.clone())), None));
+            }
+        }
+    }
+
+    #[test]
+    fn only_body_conditions_ask_for_the_body() {
+        let body_rule = rule(PolicyAction::Block, Some(open_only()));
+        let header_rule = rule(
+            PolicyAction::Block,
+            Some(json!([{"target": "header", "key": "x", "operator": "in", "value": ["y"]}])),
+        );
+        assert!(needs_body_buffer(&[header_rule.clone(), body_rule]));
+        assert!(!needs_body_buffer(&[header_rule]));
+        assert!(!needs_body_buffer(&[rule(PolicyAction::Block, None)]));
+    }
+
+    #[test]
+    fn only_methods_with_a_body_are_buffered() {
+        assert!(method_has_body("post"));
+        assert!(method_has_body("PUT"));
+        assert!(!method_has_body("GET"));
+        assert!(!method_has_body("CONNECT"));
+    }
 }
