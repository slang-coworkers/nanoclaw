-/// `false` always: OSS's `condition_match` arm cannot buffer bodies and never
-/// evaluates conditions (they match vacuously, exactly like the legacy OSS
-/// gateway), so there is nothing to buffer for.
-pub(crate) fn needs_body_buffer(_v2: &PolicyV2Rules) -> bool {
-    false
+/// Whether any loaded rule has a condition on the request body, so the gateway buffers the body
+/// before the decision. The `condition_match` arm decides which conditions read the body; we hand it
+/// each rule's conditions as a legacy rule, because it works on that shape in both editions.
+pub(crate) fn needs_body_buffer(v2: &PolicyV2Rules) -> bool {
+    let conditioned: Vec<PolicyRule> = v2
+        .org
+        .iter()
+        .chain(v2.project.iter())
+        .filter(|r| r.conditions.is_some())
+        .map(|r| PolicyRule {
+            name: r.name.clone(),
+            path_pattern: String::new(),
+            method: None,
+            action: PolicyAction::Block,
+            conditions_raw: r.conditions.clone(),
+        })
+        .collect();
+    crate::condition_match::needs_body_buffer(&conditioned)
 }
 
