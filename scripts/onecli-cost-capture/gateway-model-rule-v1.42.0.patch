+/// The conditions of a rule as a list, or `None` when the rule has no conditions.
+fn condition_list(rule: &PolicyRule) -> Option<&Vec<serde_json::Value>> {
+    rule.conditions_raw
+        .as_ref()
+        .and_then(|v| v.as_array())
+        .filter(|a| !a.is_empty())
+}
+
+fn is_body_condition(cond: &serde_json::Value) -> bool {
+    cond.get("target").and_then(|t| t.as_str()) == Some("body")
+}
+
+/// Whether any rule has a condition on the request body, so the gateway must buffer the body.
+pub(crate) fn needs_body_buffer(rules: &[PolicyRule]) -> bool {
+    rules
+        .iter()
+        .filter_map(condition_list)
+        .any(|list| list.iter().any(is_body_condition))
+}
+
+/// Whether the conditions of `rule` hold for a request with the given body.
+///
+/// A rule with no conditions holds, as it did before this matcher existed.
+///
+/// `path` is the request path with its query string, as the gateway received it.
+pub(crate) fn matches_at(rule: &PolicyRule, body: Option<&[u8]>, path: &str) -> bool {
+    let Some(list) = condition_list(rule) else {
+        return true;
+    };
+    list.iter().all(|cond| eval(cond, body, path).unwrap_or(true))
+}
+
+/// `matches_at` for a request with no query string.
+#[cfg(test)]
+pub(crate) fn matches(rule: &PolicyRule, body: Option<&[u8]>) -> bool {
+    matches_at(rule, body, "")
+}
+
+/// Evaluate one condition. Returns `None` when the condition is not one we understand.
+fn eval(cond: &serde_json::Value, body: Option<&[u8]>, path: &str) -> Option<bool> {
+    match cond.get("target").and_then(|t| t.as_str()) {
+        Some("body") => eval_body(cond, body),
+        Some("query") => eval_query(cond, path),
+        _ => None,
+    }
+}
+
+/// The globs of a condition's `value`, or `None` when the value is malformed.
+fn condition_globs(cond: &serde_json::Value) -> Option<Vec<&str>> {
+    match cond.get("value")? {
+        serde_json::Value::String(s) => Some(
+            s.split(',')
+                .map(str::trim)
+                .filter(|g| !g.is_empty())
+                .collect(),
+        ),
+        serde_json::Value::Array(items) => items
+            .iter()
+            .map(|v| v.as_str())
+            .collect::<Option<Vec<_>>>(),
+        _ => None,
+    }
+}
+
+/// Evaluate a condition on the JSON request body.
+fn eval_body(cond: &serde_json::Value, body: Option<&[u8]>) -> Option<bool> {
+    let key = cond.get("key")?.as_str()?;
+    let operator = cond.get("operator")?.as_str()?;
+    let globs = condition_globs(cond)?;
+    let field = body_field(body, key);
+    let listed = field
+        .as_deref()
+        .is_some_and(|f| globs.iter().any(|g| glob_match(g, f)));
+    match operator {
+        "in" => Some(listed),
+        "not_in" => Some(!listed),
+        _ => None,
+    }
+}
+
+/// Evaluate a condition on the query string of the request path.
+fn eval_query(cond: &serde_json::Value, path: &str) -> Option<bool> {
+    let key = cond.get("key")?.as_str()?;
+    let operator = cond.get("operator")?.as_str()?;
+    let globs = condition_globs(cond)?;
+    let values = query_values(path, key);
+    let unlisted = values
+        .iter()
+        .any(|v| !globs.iter().any(|g| glob_match(g, v)));
+    match operator {
+        "in" => Some(!values.is_empty() && !unlisted),
+        "not_in" => Some(unlisted),
+        _ => None,
+    }
+}
+
+/// Every value of the query parameter `name`, in each decoded form a server might read: decoded once
+/// and decoded until it no longer changes. A name matches in any ASCII case, in either form.
+fn query_values(path: &str, name: &str) -> Vec<String> {
+    let Some((_, query)) = path.split_once('?') else {
+        return Vec::new();
+    };
+    let query = query.split('#').next().unwrap_or(query);
+    let mut values = Vec::new();
+    for pair in query.split(['&', ';']) {
+        let (raw_name, raw_value) = pair.split_once('=').unwrap_or((pair, ""));
+        if decoded_forms(raw_name)
+            .iter()
+            .any(|n| n.eq_ignore_ascii_case(name))
+        {
+            values.extend(decoded_forms(raw_value));
+        }
+    }
+    values
+}
+
+/// A form-encoded string decoded once and decoded until stable: `+` is a space, and `%xx` is a byte.
+fn decoded_forms(raw: &str) -> Vec<String> {
+    let once = percent_decode(&raw.replace('+', " "));
+    let full = percent_decode_fully(&once);
+    if once == full {
+        vec![once]
+    } else {
+        vec![once, full]
+    }
+}
+
+fn hex_value(b: u8) -> Option<u8> {
+    (b as char).to_digit(16).map(|d| d as u8)
+}
+
+/// Decode every well-formed `%xx` once; a malformed escape stays as it is.
+fn percent_decode(s: &str) -> String {
+    let b = s.as_bytes();
+    let mut out = Vec::with_capacity(b.len());
+    let mut i = 0;
+    while i < b.len() {
+        if b[i] == b'%' && i + 2 < b.len() {
+            if let (Some(h), Some(l)) = (hex_value(b[i + 1]), hex_value(b[i + 2])) {
+                out.push(h * 16 + l);
+                i += 3;
+                continue;
+            }
+        }
+        out.push(b[i]);
+        i += 1;
+    }
+    String::from_utf8_lossy(&out).into_owned()
+}
+
+/// Decode until the text stops changing, at most four times, because a proxy in front of the server
+/// may decode once more before the server does.
+fn percent_decode_fully(s: &str) -> String {
+    let mut current = s.to_string();
+    for _ in 0..4 {
+        let next = percent_decode(&current);
+        if next == current {
+            break;
+        }
+        current = next;
+    }
+    current
+}
+
+/// Split a request path into its path and its query string.
+fn split_query(raw: &str) -> (&str, Option<&str>) {
+    match raw.split_once('?') {
+        Some((p, q)) => (p, Some(q)),
+        None => (raw, None),
+    }
+}
+
+/// The path as an origin server routes it once it has decoded the path text it holds: empty and `.`
+/// segments dropped, `..` resolved, a trailing slash kept, and the query string kept at the end.
+fn clean_path(decoded: &str, query: Option<&str>) -> String {
+    let mut segments: Vec<&str> = Vec::new();
+    for segment in decoded.split('/') {
+        match segment {
+            "" | "." => {}
+            ".." => {
+                segments.pop();
+            }
+            other => segments.push(other),
+        }
+    }
+    let mut out = format!("/{}", segments.join("/"));
+    if decoded.ends_with('/') && !segments.is_empty() {
+        out.push('/');
+    }
+    if let Some(q) = query {
+        out.push('?');
+        out.push_str(q);
+    }
+    out
 }
 
