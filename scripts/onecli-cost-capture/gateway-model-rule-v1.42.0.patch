+/// The views of a request path that a rule must meet: the path as sent, decoded once, and decoded
+/// until stable, each cleaned. A rule on `/model/*` holds when any view meets it.
+///
+/// The server behind the gateway decodes and cleans the path before it routes, and we do not know how
+/// many times it decodes. `/%6Dodel/info`, `/model%2Finfo`, `//model/info`, `/./model/info` and
+/// `/v1/../model/info` all reach `/model/info`, and each is one view of that route. One decoding is not
+/// enough, and neither is a full decoding: `/model/%252e%252e/invoke` decodes to `/invoke` after the
+/// full decoding, but a server that decodes once routes it to `/model/<id>/invoke` with the id
+/// `%2e%2e`. A block rule must hold for every route the server might take, so it holds for each view.
+pub(crate) fn path_views(raw: &str) -> Vec<String> {
+    let (path, query) = split_query(raw);
+    let mut views: Vec<String> = Vec::new();
+    for form in [
+        path.to_string(),
+        percent_decode(path),
+        percent_decode_fully(path),
+    ] {
+        let view = clean_path(&form, query);
+        if !views.contains(&view) {
+            views.push(view);
+        }
+    }
