# Release-age quarantine, restated for the two clients that read this file.
# pnpm-workspace.yaml holds the authoritative setting (4320 min = 3 days).
#
# The keys are NOT interchangeable, and each is ignored in silence by the other
# tool — which is how the workspace setting managed to sit inert. Verified
# against the pinned pnpm 10.33.0: `minReleaseAge` here has no effect on pnpm,
# so this file was a safety net that caught nothing.
#
# npm 11's key:
minReleaseAge=3d
# pnpm's key (kebab-case form of minimumReleaseAge). Covers pnpm invocations
# that do not resolve the workspace file — notably `pnpm install -g`.
minimum-release-age=4320
