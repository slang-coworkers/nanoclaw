{
  // Typecheck-only view of the repo. SEPARATE from tsconfig.json on purpose:
  // that file is the BUILD config (`pnpm run build` → `tsc`), with
  // `rootDir: ./src`, `outDir: ./dist` and `declaration: true`. Widening its
  // `include` to reach setup/ and scripts/ would make the build try to emit
  // them into dist/, and rootDir would reject them outright. So the gate gets
  // its own config that inherits the same strictness and emits nothing.
  //
  // Run it through `scripts/typecheck-gate.mjs`, never bare: the gate compares
  // against scripts/typecheck-baseline.txt so pre-existing errors do not block,
  // while any NEW one does.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // scripts/ mixes .ts and hand-written .mjs (release.mjs, typecheck-gate.mjs,
    // mirror-skills.mjs, check-runtime-resolvable.mjs, and setup/registry's
    // credential-helper.mjs). scripts/release.test.ts imports release.mjs, so
    // without allowJs it is an implicit any (TS7016). The alternative — a
    // hand-written release.d.mts — duplicates six signatures with nothing
    // checking that the copy stays true, which is how a declaration file starts
    // lying. Inferring from the .mjs source cannot drift.
    //
    // `checkJs` stays OFF (its default): these files are typechecked as
    // dependencies, never judged as sources. Turning it on would open a second
    // debt front in files the build never compiles.
    "allowJs": true,
    // Files live outside ./src now, so the build's rootDir cannot apply.
    "rootDir": ".",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  // src/ was already covered by the build config; setup/ (98 files) and
  // scripts/ (38) never were. container/agent-runner has its own tsconfig and
  // its own CI step — it is not listed here, but several scripts/ and setup/
  // files import it, so tsc loads it transitively anyway.
  //
  // setup/types/optional-modules.d.ts comes in under `setup`; it lives there
  // rather than at a new top-level types/ because nv-main already owns setup/**
  // (.github/nv-path-guard/nv-main.txt) and the stubs exist for setup's files.
  "include": ["src*", "setup", "scripts"],
  "exclude": ["node_modules", "dist"]
}
