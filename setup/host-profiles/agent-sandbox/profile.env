# Settings for NVIDIA agent sandbox VMs. prep.sh writes each key into .env
# unless .env already sets it, so an operator's own value survives re-runs.
#
# Agents run under podman's Docker-compatible API with slirp4netns: the VM drops
# forwarded traffic, so Docker bridge networks have no egress.
NANOCLAW_AGENT_DOCKER_HOST=unix:///run/podman/podman.sock
NANOCLAW_AGENT_NETWORK=slirp4netns
NANOCLAW_SLIRP_HOST_IP=10.0.2.2
# Image builds: built here (NanoClaw's image-fetch sign-in is unreachable from
# corpnet), on the host network (same reason as above), trusting the sandbox's
# CA for its TLS inspection, Debian over HTTPS (plain HTTP answers 403), and
# Artifactory for the downloads corpnet blocks.
NANOCLAW_HARDENED_IMAGE=false
NANOCLAW_BUILD_NETWORK=host
NANOCLAW_EXTRA_CA_DIR=/usr/local/share/ca-certificates/nvidia
NANOCLAW_DEBIAN_MIRROR=https://deb.debian.org
NANOCLAW_GITHUB_RELEASES_MIRROR=https://urm.nvidia.com/artifactory/github-releases-remote
NANOCLAW_DOCKERHUB_MIRROR=urm.nvidia.com/docker-remote
NANOCLAW_GHCR_MIRROR=urm.nvidia.com/ghcr-remote
