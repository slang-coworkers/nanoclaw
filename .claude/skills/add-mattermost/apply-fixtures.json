        { "match": "/api/v4/users/username/owner.test", "stdout": "{\"id\":\"oooooooooooooooooooooooooo\"}" },
        { "match": "/api/v4/channels/direct", "stdout": "mattermost:dddddddddddddddddddddddddd" }
      ]
