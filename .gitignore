# Dependencies
node_modules/
.npm-cache/
# pnpm content-addressable store (created when running in sandbox mode)
.pnpm-store/
# Build output
dist/

# Local data & auth
store/
data/
logs/

# Groups - per-installation state, not tracked
groups/*

# Per-group memory (CLAUDE.local.md) must never be committed.
**/CLAUDE.local.md

# Secrets
*.keys.json
.env
.env*

# Temp files
.tmp-*

# Manual/nohup service state (generated by setup on WSL or hosts without a
# service manager; snapshot by update-nanoclaw, never source-controlled)
start-nanoclaw.sh
nanoclaw.pid

# OS
.DS_Store

# IDE
.idea/
.vscode/

# Skills system (local per-installation state)
.nanoclaw/

# External skills manifest (generated by scripts/fetch-skills.sh)
container/skills/.external-skills.json

agents-sdk-docs
repos/

!groups/templates/
coworkers/*.yaml
coworkers/*.yaml.bak
coworkers/*.tar.gz
.codex
.claude/projects/*/memory/
.agents
AGENTS.md

# Internal working docs, never committed
docs/maintainer-guide.md
docs/drafts/
forks.md

# Local knowledge/scratch corpora, archives, runtime pidfiles — never tracked.
# slang_kb/ is a large raw-export corpus that must never be `git add`-ed.
slang_kb/
*.zip
*.pid

# npm lockfile: this project uses pnpm exclusively (pnpm-workspace.yaml +
# minimumReleaseAge). A stray package-lock.json bypasses that supply-chain gate.
package-lock.json
__pycache__/

# The patched claude-trace build is vendored ON PURPOSE (see
# container/claude-trace/BUILD.md) so a deploy needs no node build. The blanket
# `dist/` rule above would silently swallow it — and its absence is invisible at
# runtime: resolveClaudeTraceDir() just returns null and tracing is quietly off.
# Git will not descend into an excluded directory, so the DIRECTORIES must be
# un-ignored, not merely the files inside them.
!container/claude-trace/dist/
!container/claude-trace/frontend/dist/
