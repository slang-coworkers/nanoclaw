# Dependencies
node_modules/
.npm-cache/
# pnpm content-addressable store (created when running in sandbox mode)
.pnpm-store/
# Build output
dist/

# Local data & auth
store/
data/
logs/

# Groups - per-installation state, not tracked
groups/*

# Per-group memory (CLAUDE.local.md) must never be committed.
**/CLAUDE.local.md

# Secrets
*.keys.json
.env
.env*

# Temp files
.tmp-*

# Manual/nohup service state (generated by setup on WSL or hosts without a
# service manager; snapshot by update-nanoclaw, never source-controlled)
start-nanoclaw.sh
nanoclaw.pid

# OS
.DS_Store

# IDE
.idea/
.vscode/

# Skills system (local per-installation state)
.nanoclaw/

agents-sdk-docs
.agents
AGENTS.md

# Internal working docs, never committed
docs/maintainer-guide.md
docs/drafts/
forks.md

# Python bytecode. Nothing in-tree is a Python package, but the repo carries
# Python (the path-guard matcher, the MCP servers, skill scripts) and running any
# of it leaves these behind — 8fa7f2c had to delete a batch that got committed.
__pycache__/
*.py[cod]
