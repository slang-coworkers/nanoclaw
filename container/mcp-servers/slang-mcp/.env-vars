# Runtime env vars for slang-mcp. Declaring a var here makes OneCLI
# inject its real value for this stdio MCP process (RC-M5). Keep this in
# sync with os.getenv/os.environ calls under src/ — missing entries here
# cause the running MCP server to read None/empty even when the
# credential is configured in the vault.
DISCORD_BOT_TOKEN
DISCORD_ALLOWED_SEND_CHANNELS
DISCORD_ALLOWED_SEND_FORUMS
DISCORD_FEEDBACK_DIR
DISCORD_WATCHED_FORUMS
GH_TOKEN
GITHUB_ACCESS_TOKEN
GITHUB_API_BASE
GITLAB_ACCESS_TOKEN
SLACK_BOT_TOKEN
SLACK_USER_TOKEN
SLACK_TEAM_ID
