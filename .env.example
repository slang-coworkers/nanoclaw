# Claude authentication (one of these is required)
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_CODE_OAUTH_TOKEN=...
# ANTHROPIC_AUTH_TOKEN=...

# Custom API endpoint (optional)
# ANTHROPIC_BASE_URL=https://...

# Model overrides (optional)
# ANTHROPIC_DEFAULT_OPUS_MODEL=...
# ANTHROPIC_DEFAULT_SONNET_MODEL=...
# ANTHROPIC_DEFAULT_HAIKU_MODEL=...

# Claude Code settings
# CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1

# GPU support (optional) — build the agent image with CUDA + Vulkan loader +
# GLVND so containers can use the NVIDIA GPU (compute and Vulkan/graphics).
# Adds several GB to the image. Requires an NVIDIA GPU + the nvidia container
# runtime on the host (the host passes --runtime=nvidia automatically when a
# GPU is detected). Honored by both ./container/build.sh and /setup.
# ENABLE_GPU=1

# MCP server tokens — passed to auto-detected stdio servers (override per server via .env-vars file)
# GITHUB_ACCESS_TOKEN=ghp_...
# DISCORD_BOT_TOKEN=...
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_TEAM_ID=T...
# GITLAB_ACCESS_TOKEN=glpat-...
# SLACK_USER_TOKEN=xoxp-...

# MCP configuration (optional)
# DEFAULT_MCP_TOOLS=mcp__myserver__mytool,mcp__myserver__othertool
# REMOTE_MCP_SERVERS=myserver|https://example.com/mcp

# Dashboard (optional)
# DASHBOARD_PORT=3737
# DASHBOARD_SECRET=...

# GitHub webhook receiver (optional — required for @nv-slang-bot PR mention routing)
# GITHUB_WEBHOOK_SECRET=<secret from GitHub App settings>
# GITHUB_WEBHOOK_PORT=3841
# GITHUB_WEBHOOK_BOT_MENTION=@nv-slang-bot

# Approval-decision ledger — which agent groups may call record_decision.
# REQUIRED to run the PR-approver flow: `record_decision` is exposed by the core
# MCP server to EVERY container, so the host refuses it unless the calling group
# is named here. Unset = no container may write (fail-closed); a denial is
# logged at ERROR naming this variable.
# Comma-separated agent-group ids and/or folders.
# APPROVAL_LEDGER_WRITERS=slang-pr-approver,slangpy-pr-approver
