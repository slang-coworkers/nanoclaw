[Unit]
Description=NanoClaw Contributor AI Standard compliance check (read-only score, writes a report)
# The report is read by nanoclaw-metrics.py, which runs on its own timer; there is
# no ordering dependency because a stale report is itself a signal (age_sec).
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Runs as the nanoclaw owner: the only write is the report under the data tree,
# which that user owns. GitHub is read through that user's `gh` login with GET
# requests only; the judge, when configured, is a POST of text to the model
# endpoint and changes nothing.
User=ubuntu
Group=ubuntu
EnvironmentFile=-/etc/nanoclaw-compliance-check.env
Environment=NANOCLAW_DIR=/home/ubuntu/slang-coworkers-prod/nanoclaw
ExecStart=/usr/bin/python3 /usr/local/bin/compliance-check/compliance_check.py --quiet
# Exit 1 (findings) and 2 (indeterminate) are the tool's report, not a crash;
# the journal keeps the summary line and the metrics carry the counts.
SuccessExitStatus=1 2
TimeoutStartSec=45min
ProtectSystem=strict
# The report directory is the only writable path. `gh` needs its config to be
# readable, which ProtectSystem=strict leaves alone under /home.
ReadWritePaths=/home/ubuntu/slang-coworkers-prod/nanoclaw/data/shared/compliance
PrivateTmp=true
NoNewPrivileges=true
