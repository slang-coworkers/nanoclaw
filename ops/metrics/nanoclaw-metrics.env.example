# /etc/nanoclaw-metrics.env — write target for nanoclaw-metrics-push.sh.
#
# The REAL file lives on the box and holds a secret; it is NOT in git.
# Copy this to /etc/nanoclaw-metrics.env and fill in the credential.
#
# InfluxDB here is 2.x. The Grafana datasource reads with a 1.x-compat
# user/password (READ-only), so WRITING must use the v2 token via
# /api/v2/write — the same token telegraf writes with (grab it from
# /etc/telegraf/telegraf.d/*.conf). org and bucket are both "lp".
INFLUX_URL=http://127.0.0.1:8086
INFLUX_ORG=lp
INFLUX_BUCKET=lp
INFLUX_TOKEN=CHANGE_ME
COLLECTOR=/usr/local/bin/nanoclaw-metrics.py

# Legacy 1.x write fallback (only used if INFLUX_TOKEN is empty). The v1 user is
# typically read-only, so these usually 403 on write — kept for completeness.
INFLUX_DB=lp
INFLUX_USER=
INFLUX_PASS=
